// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



enum BranchAccessType {
  ALL
  SELECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id        String @id @default(uuid())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name     String
  email    String @unique
  phone    String?
  password String

  status   UserStatus @default(ACTIVE)
  isActive Boolean    @default(true)

  branchAccessType BranchAccessType @default(SELECTED)

  userRoles UserRole[]

  createdById  String?
  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([email])
}


model Branch {
  id   String @id @default(uuid())

  name String
  code String @unique

  gstin     String? @unique
  stateCode String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pinCode      String?

  isActive Boolean @default(true)

  users User[]
  agencies AgencyBranch[]
  inventories Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gstin])
}

model Role {
  id String @id @default(uuid())

  name String
  code String @unique

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id        String @id @default(uuid())

  module    String
  action    String
  key       String @unique

  description String?
  isActive    Boolean @default(true)

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  id           String @id @default(uuid())

  roleId       String
  role         Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id       String @id @default(uuid())

  userId   String
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId   String
  role     Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  
  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

enum AgencyType {
  VENDOR
  CLIENT
  BOTH
}

model Agency {
  id   String @id @default(uuid())

  name String
  type AgencyType

  gstin     String? @unique

  contactPerson String?
  mobileNumber   String?
  email         String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  stateCode    String?
  pinCode      String?

  isActive Boolean @default(true)

  branches  AgencyBranch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([gstin])
  @@index([type])
}

model AgencyBranch {
  id String @id @default(uuid())

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  openingBalance Decimal @default(0.00) @db.Decimal(18, 3)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([agencyId, branchId])
  @@index([agencyId])
  @@index([branchId])
}

enum ProductUnit {
  KG
  LTR
}

model Product {
  id    String @id @default(uuid())

  sku   String @unique

  name  String
  category String?
  description String?

  hsnNo String?
  applicableGST Decimal? @db.Decimal(5, 2)

  baseUnit ProductUnit @default(KG)
  density  Decimal? @db.Decimal(10, 4)

  sellPricePerUnit Decimal @db.Decimal(18, 2)

  operationalUnit ProductUnit @default(LTR)
  minimumStockKG Decimal? @db.Decimal(18, 3)

  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories Inventory[]

  @@index([sku])
  @@index([name])
  @@index([category])
  @@index([hsnNo])
}

model Inventory {
  id     String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  currentStockKG Decimal @default(0.000) @db.Decimal(18, 3)
  currentStockLTR Decimal @default(0.000) @db.Decimal(18, 3)

  createdAt DateTime @default(now())
  lastUpdated  DateTime @updatedAt

  @@unique([branchId, productId])

  @@index([branchId])
  @@index([productId])
}