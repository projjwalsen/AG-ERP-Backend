// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}



enum BranchAccessType {
  ALL
  SELECTED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id        String @id @default(uuid())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name     String
  email    String @unique
  phone    String?
  password String

  status   UserStatus @default(ACTIVE)
  isActive Boolean    @default(true)

  branchAccessType BranchAccessType @default(SELECTED)

  userRoles UserRole[]
  purchasesCreated Purchase[] @relation("PurchaseCreatedBy")
  purchasesApproved Purchase[] @relation("PurchaseApprovedBy")
  salesCreated Sale[] @relation("SaleCreatedBy")
  salesApproved Sale[] @relation("SaleApprovedBy")

  createdById  String?
  createdBy    User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([email])
}


model Branch {
  id   String @id @default(uuid())

  name String
  code String @unique

  gstin     String? @unique
  stateCode String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  pinCode      String?
  phnNumber     String?
  email         String?

  isActive Boolean @default(true)

  users User[]
  agencies AgencyBranch[]
  inventoryBatches InventoryBatch[]
  purchases Purchase[]
  sales Sale[]
  inventories Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gstin])
}

model Role {
  id String @id @default(uuid())

  name String
  code String @unique

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id        String @id @default(uuid())

  module    String
  action    String
  key       String @unique

  description String?
  isActive    Boolean @default(true)

  rolePermissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  id           String @id @default(uuid())

  roleId       String
  role         Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id       String @id @default(uuid())

  userId   String
  user     User @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleId   String
  role     Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())
  
  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

enum AgencyType {
  VENDOR
  CLIENT
  BOTH
}

model Agency {
  id   String @id @default(uuid())

  name String
  type AgencyType

  gstin     String? @unique

  contactPerson String?
  mobileNumber   String?
  email         String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  stateCode    String?
  pinCode      String?

  isActive Boolean @default(true)

  branches  AgencyBranch[]
  purchases Purchase[]
  sales Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([gstin])
  @@index([type])
}

model AgencyBranch {
  id String @id @default(uuid())

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  openingBalance Decimal @default(0.00) @db.Decimal(18, 3)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([agencyId, branchId])
  @@index([agencyId])
  @@index([branchId])
}

enum ProductUnit {
  KG
  LTR
}

model Product {
  id    String @id @default(uuid())

  sku   String @unique

  name  String
  category String?
  description String?

  hsnNo String?
  applicableGST Decimal? @db.Decimal(5, 2)

  baseUnit ProductUnit @default(KG)
  density  Decimal? @db.Decimal(10, 4)

  sellPricePerUnit Decimal @db.Decimal(18, 2)

  operationalUnit ProductUnit @default(LTR)
  minimumStockKG Decimal? @db.Decimal(18, 3)

  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories Inventory[]
  inventoryBatches InventoryBatch[]
  purchaseItems PurchaseItem[]
  salesItems SalesItem[]

  @@index([sku])
  @@index([name])
  @@index([category])
  @@index([hsnNo])
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SalesStatus {
  PENDING
  APPROVED
  REJECTED
}

model InventoryBatch {
  id String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  batchNo String
  purchasePrice Decimal @db.Decimal(18, 2)

  availableQtyKG Decimal @default(0.000) @db.Decimal(18, 3)
  availableQtyLTR Decimal @default(0.000) @db.Decimal(18, 3)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  lastUpdated  DateTime @updatedAt

  purchaseItems PurchaseItem[]
  salesItems SalesItem[]

  @@index([branchId])
  @@index([productId])
  @@index([batchNo])
  @@unique([branchId, productId, batchNo])
}

/** Purchase Model Master **/
model Purchase {
  id String @id @default(uuid())

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  invoiceNo String @unique
  status   PurchaseStatus @default(PENDING)
  remarks String?

  createdById  String?
  createdBy    User?  @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  
  approvedById String?
  approvedBy   User?  @relation("PurchaseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  approvedAt DateTime?

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PurchaseItem {
  id String @id @default(uuid())

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  batchId String?
  batch   InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  batchNo String
  quantity Decimal @db.Decimal(18, 3)
  unit ProductUnit

  purchasePrice Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
}


/** Sale Model Master **/

model Sale {
  id String @id @default(uuid())

  agencyId String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  invoiceNo String @unique
  status   SalesStatus @default(PENDING)
  remarks String?

  createdById  String?
  createdBy    User?  @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  
  approvedById String?
  approvedBy   User?  @relation("SaleApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  approvedAt DateTime?

  items SalesItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model SalesItem {
  id String @id @default(uuid())

  saleId String
  sale   Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  batchId String
  batch   InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  quantity Decimal @db.Decimal(18, 3)
  unit ProductUnit

  sellingPrice Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
}


model Inventory {
  id     String @id @default(uuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  currentStockKG Decimal @default(0.000) @db.Decimal(18, 3)
  currentStockLTR Decimal @default(0.000) @db.Decimal(18, 3)

  createdAt DateTime @default(now())
  lastUpdated  DateTime @updatedAt

  @@unique([branchId, productId])

  @@index([branchId])
  @@index([productId])
}