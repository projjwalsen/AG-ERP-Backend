<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>TAX INVOICE - {{invoiceNo}}</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: Arial, sans-serif; font-size:11px; color:#000; background:#fff; }

    .page {
      width: 794px;
      margin: 0 auto;
      padding: 18px 20px 10px;
    }

    /* ─── MASTER TABLE: single collapsed table for entire invoice ─── */
    .inv {
      width: 100%;
      border-collapse: collapse;
      border: 1px solid #000;
    }
    .inv td, .inv th {
      border: 1px solid #000;
      padding: 3px 6px;
      vertical-align: top;
      font-size: 11px;
    }

    /* Title row */
    .title-cell {
      text-align: center;
      font-size: 15px;
      font-weight: bold;
      letter-spacing: 1px;
      border-left: none !important;
      border-right: none !important;
      border-top: none !important;
      padding: 4px 6px;
    }
    .dup-cell {
      font-size: 10px;
      font-style: italic;
      text-align: right;
      vertical-align: middle;
      border-right: none !important;
      border-top: none !important;
      white-space: nowrap;
      padding: 4px 6px;
    }
    .title-wrap-cell {
      border: none !important;
      padding: 0 !important;
    }

    /* Label / value helpers */
    .lbl  { font-size:9.5px; color:#333; display:block; }
    .bold { font-weight:bold; }
    .right{ text-align:right; }
    .center{ text-align:center; }

    /* ─── ITEMS inner table (nested, borderless outer) ─── */
    .items {
      width: 100%;
      border-collapse: collapse;
    }
    .items th, .items td {
      border: 1px solid #000;
      padding: 3px 5px;
      font-size: 10.5px;
    }
    /* remove outer borders so parent cell border is used */
    .items thead tr:first-child th { border-top: none; }
    .items tbody tr:last-child  td { border-bottom: none; }
    .items tr th:first-child,
    .items tr td:first-child      { border-left: none; }
    .items tr th:last-child,
    .items tr td:last-child       { border-right: none; }

    .items .c-sl     { width:34px;  text-align:center; }
    .items .c-desc   { min-width:120px; text-align:left; }
    .items .c-hsn    { width:76px;  text-align:center; }
    .items .c-qty    { width:56px;  text-align:center; }
    .items .c-uprice { width:68px;  text-align:right;  } /* Unit Price       */
    .items .c-base   { width:74px;  text-align:right;  } /* Qty × Unit Price */
    .items .c-gst    { width:46px;  text-align:center; } /* GST %            */
    .items .c-amtgst { width:82px;  text-align:right;  } /* Amt with GST     */

    /* spacer body — keeps left/right borders, opens top/bottom */
    .spacer td {
      border-top: none !important;
      border-bottom: none !important;
      height: 200px;
    }

    /* ─── TAX SUMMARY inner table ─── */
    .taxsum {
      width: 100%;
      border-collapse: collapse;
    }
    .taxsum th, .taxsum td {
      border: 1px solid #000;
      padding: 3px 5px;
      font-size: 10px;
    }
    .taxsum thead tr:first-child th { border-top: none; }
    .taxsum tbody tr:last-child  td { border-bottom: none; }
    .taxsum tr th:first-child,
    .taxsum tr td:first-child       { border-left: none; }
    .taxsum tr th:last-child,
    .taxsum tr td:last-child        { border-right: none; }
    .taxsum td { text-align:right; }
    .taxsum td:first-child { text-align:left; }
    .taxsum th { text-align:center; font-weight:bold; }

    /* signature */
    .sig-img { display:block; margin-left:auto; height:32px; }
    .footer  { text-align:center; font-size:9.5px; margin-top:8px; }
  </style>
</head>
<body>
<div class="page">
<table class="inv">

  <!-- ══ ROW 0: TITLE ══ -->
  <tr>
    <td colspan="2" class="title-cell">TAX INVOICE</td>
    <td class="dup-cell">Duplicate Copy</td>
  </tr>

  <!-- ══ ROW 1: Seller (rowspan 2) | Invoice No | Dated ══ -->
  <tr>
    <td rowspan="2" style="width:55%">
      <div class="bold" style="font-size:12px">{{sellerName}}</div>
      <div>{{sellerAddress}}</div>
      <div>{{sellerPhone}}</div>
    </td>
    <td style="width:22%">
      <span class="lbl">Invoice No.</span>
      <span class="bold">{{invoiceNo}}</span>
    </td>
    <td style="width:23%">
      <span class="lbl">Dated</span>
      <span class="bold">{{invoiceDate}}</span>
    </td>
  </tr>

  <!-- ══ ROW 2: (seller rowspan) | Delivery Note ══ -->
  <tr>
    <td colspan="2">
      <span class="lbl">Delivery Note</span>
      {{deliveryNote}}
    </td>
  </tr>

  <!-- ══ ROW 3: GSTIN | Supplier Ref | Other Ref ══ -->
  <tr>
    <td>GSTIN/UIN: <strong>{{sellerGSTIN}}</strong></td>
    <td>
      <span class="lbl">Supplier's Ref.</span>
      {{suppliersRef}}
    </td>
    <td>
      <span class="lbl">Other Reference(s)</span>
      {{otherReference}}
    </td>
  </tr>

  <!-- ══ ROW 4: Buyer | Buyer Order No | Dated ══ -->
  <tr>
    <td>
      <span class="lbl">Buyer</span>
      <div class="bold">{{buyerName}}</div>
      <div>{{buyerAddress}}</div>
    </td>
    <td>
      <span class="lbl">Buyer's Order No.</span>
      {{buyerOrderNo}}
    </td>
    <td>
      <span class="lbl">Dated</span>
      {{buyerOrderDate}}
    </td>
  </tr>

  <!-- ══ ROW 5: (blank) | Despatch Doc No | Dated ══ -->
  <tr>
    <td style="height:22px"></td>
    <td>
      <span class="lbl">Despatch Document No.</span>
      {{despatchDocNo}}
    </td>
    <td>
      <span class="lbl">Dated</span>
      {{despatchDocDate}}
    </td>
  </tr>

  <!-- ══ ROW 6: (blank) | Despatch Through | Destination ══ -->
  <tr>
    <td style="height:22px"></td>
    <td>
      <span class="lbl">Despatch through</span>
      {{despatchThrough}}
    </td>
    <td>
      <span class="lbl">Destination</span>
      {{destination}}
    </td>
  </tr>

  <!-- ══ ROW 7: LINE ITEMS (full width nested table) ══ -->
  <tr>
    <td colspan="3" style="padding:0">
      <table class="items">
        <thead>
          <tr>
            <th class="c-sl">Sl<br>No.</th>
            <th class="c-desc" style="text-align:left"></th>
            <th class="c-hsn">HSN</th>
            <th class="c-qty">Quantity</th>
            <th class="c-uprice">Unit<br>Price</th>
            <th class="c-base">Amount</th>
            <th class="c-gst">GST rate<br>(%)</th>
            <th class="c-amtgst">Amt with<br>GST</th>
          </tr>
        </thead>
        <tbody>

          {{#each items}}
          <tr>
            <td class="c-sl center">{{slNo}}</td>
            <td class="c-desc">{{description}}</td>
            <td class="c-hsn center">{{hsn}}</td>
            <td class="c-qty center">{{quantity}}</td>
            <td class="c-uprice">{{unitPrice}}</td>
            <td class="c-base">{{baseAmount}}</td>
            <td class="c-gst center">{{gstRate}}</td>
            <td class="c-amtgst">{{amountWithGst}}</td>
          </tr>
          {{/each}}

          <!-- spacer -->
          <tr class="spacer">
            <td class="c-sl"></td>
            <td class="c-desc"></td>
            <td class="c-hsn"></td>
            <td class="c-qty"></td>
            <td class="c-uprice"></td>
            <td class="c-base"></td>
            <td class="c-gst"></td>
            <td class="c-amtgst"></td>
          </tr>

          <!-- Discount -->
          <tr>
            <td colspan="7" style="border-right:none; text-align:left">Discount</td>
            <td style="text-align:right; border-left:none">{{discount}}</td>
          </tr>

          <!-- CGST rows -->
          {{#each cgstLines}}
          <tr>
            <td colspan="6" style="border-right:none; text-align:right"><strong>CGST</strong></td>
            <td style="text-align:center; border-left:none; border-right:none">{{rate}}</td>
            <td style="text-align:right; border-left:none">{{amount}}</td>
          </tr>
          {{/each}}

          <!-- SGST rows -->
          {{#each sgstLines}}
          <tr>
            <td colspan="6" style="border-right:none; text-align:right"><strong>SGST</strong></td>
            <td style="text-align:center; border-left:none; border-right:none">{{rate}}</td>
            <td style="text-align:right; border-left:none">{{amount}}</td>
          </tr>
          {{/each}}

          <!-- IGST rows -->
          {{#each igstLines}}
          <tr>
            <td colspan="6" style="border-right:none; text-align:right"><strong>IGST</strong></td>
            <td style="text-align:center; border-left:none; border-right:none">{{rate}}</td>
            <td style="text-align:right; border-left:none">{{amount}}</td>
          </tr>
          {{/each}}

          <!-- Grand Total -->
          <tr>
            <td colspan="7" style="border-right:none; text-align:right; font-weight:bold">Total</td>
            <td style="text-align:right; border-left:none; font-weight:bold">{{grandTotal}}</td>
          </tr>

        </tbody>
      </table>
    </td>
  </tr>

  <!-- ══ ROW 8: Amount in Words ══ -->
  <tr>
    <td colspan="2">
      <strong>Amount Chargeable (in words)</strong><br>
      <strong>{{amountInWords}}</strong>
    </td>
    <td style="text-align:right; font-style:italic; font-size:10px; vertical-align:bottom">E. &amp; O.E</td>
  </tr>

  <!-- ══ ROW 9: HSN / TAX SUMMARY (full width nested table) ══ -->
  <tr>
    <td colspan="3" style="padding:0">
      <table class="taxsum">
        <thead>
          <tr>
            <th rowspan="2" style="text-align:left; width:90px">HSN/SAC</th>
            <th rowspan="2" style="width:95px">Taxable Value</th>
            <th colspan="2" style="border-bottom:none; padding-bottom:1px">Central Tax</th>
            <th colspan="2" style="border-bottom:none; padding-bottom:1px">State tax</th>
            <th rowspan="2">total tax Amount</th>
          </tr>
          <tr>
            <th style="width:44px; border-top:none; padding-top:1px">rate</th>
            <th style="width:65px; border-top:none; padding-top:1px">Amount</th>
            <th style="width:44px; border-top:none; padding-top:1px">rate</th>
            <th style="width:65px; border-top:none; padding-top:1px">Amount</th>
          </tr>
        </thead>
        <tbody>
          {{#each taxSummaryRows}}
          <tr>
            <td style="text-align:left">{{hsn}}</td>
            <td>{{taxableValue}}</td>
            <td style="text-align:center">{{cgstRate}}</td>
            <td>{{cgstAmount}}</td>
            <td style="text-align:center">{{sgstRate}}</td>
            <td>{{sgstAmount}}</td>
            <td>{{totalTax}}</td>
          </tr>
          {{/each}}
          <tr>
            <td style="text-align:left; font-weight:bold">Total</td>
            <td style="font-weight:bold">{{taxSummaryTotal.taxableValue}}</td>
            <td></td>
            <td style="font-weight:bold">{{taxSummaryTotal.cgstAmount}}</td>
            <td></td>
            <td style="font-weight:bold">{{taxSummaryTotal.sgstAmount}}</td>
            <td style="font-weight:bold">{{taxSummaryTotal.totalTax}}</td>
          </tr>
        </tbody>
      </table>
    </td>
  </tr>

  <!-- ══ ROW 10: Tax Amount in Words ══ -->
  <tr>
    <td colspan="3">
      <strong>Tax Amount (in Words) :</strong>&nbsp;&nbsp;
      <strong>{{taxAmountInWords}}</strong>
    </td>
  </tr>

  <!-- ══ ROW 11: Declaration | Signature ══ -->
  <tr>
    <td colspan="2" style="font-size:9.5px; vertical-align:top">
      <strong>Declaration</strong><br>
      We declare that this invoice shows the actual price of the goods<br>
      described and that all particulers are true and correct.
    </td>
    <td style="text-align:right; vertical-align:bottom; padding-bottom:5px">
      <div>for <strong>{{sellerCompanyName}}</strong></div>
      {{#if signatureImage}}
      <img class="sig-img" src="{{signatureImage}}" alt="Authorised Signature"/>
      {{else}}
      <div style="height:40px"></div>
      {{/if}}
      <div style="font-size:9.5px">Authorised Signatory</div>
    </td>
  </tr>

  <!-- ══ ROW 12: Customer Seal ══ -->
  <tr>
    <td colspan="2" style="font-size:10px">Customer's seal and Signature</td>
    <td></td>
  </tr>

</table>

<div class="footer">This is a Computer Generated Invoice</div>
</div>
</body>
</html>