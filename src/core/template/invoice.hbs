<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>TAX INVOICE - {{invoiceNo}}</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family: Arial, sans-serif; color:#000; background:#fff; }
    .page { width:794px; margin:0 auto; padding:18px 20px 10px; }
    .top-strip { display:flex; justify-content:space-between; align-items:flex-start; font-size:10.5px; margin-bottom:4px; }
    .irn-block { flex:1; max-width:620px; overflow-wrap:anywhere; word-break:break-all; }
    .irn-block .row { display:flex; align-items:flex-start; margin-bottom:2px; font-weight:bold; }
    .irn-block .value { flex:1; min-width:0; }
    .lbl-inline { display:inline-block; flex:0 0 72px; }
    .einv { text-align:right; }
    .einv-label { font-size:11px; font-weight:bold; margin-bottom:2px; }
    .qr-img { width:70px; height:70px; object-fit:contain; }
    .doc-title { text-align:center; font-size:16px; font-weight:bold; margin-bottom:4px; }
    .inv { width:100%; border-collapse:collapse; border:1px solid #000; }
    .inv td, .inv th { border:1px solid #000; padding:3px 6px; vertical-align:top; font-size:11px; }
    .lbl { font-size:10px; color:#333; display:block; }
    .bold { font-weight:bold; }
    .center { text-align:center; }
    .seller-hdr { display:flex; align-items:flex-start; gap:12px; min-height:112px; }
    .logo-img { width:82px; height:82px; object-fit:contain; flex-shrink:0; margin-top:2px; }
    .seller-details { flex:1; min-width:0; line-height:1.25; }
    .seller-name { font-size:12px; font-weight:bold; line-height:1.25; margin-bottom:2px; }
    .items, .taxsum { width:100%; border-collapse:collapse; }
    .items th, .items td { border:1px solid #000; padding:3px 5px; font-size:11.5px; }
    .items thead tr:first-child th, .taxsum thead tr:first-child th { border-top:none; }
    .items tbody tr:last-child td, .taxsum tbody tr:last-child td { border-bottom:none; }
    .items tr th:first-child, .items tr td:first-child,
    .taxsum tr th:first-child, .taxsum tr td:first-child { border-left:none; }
    .items tr th:last-child, .items tr td:last-child,
    .taxsum tr th:last-child, .taxsum tr td:last-child { border-right:none; }
    .c-sl { width:32px; text-align:center; }
    .c-desc { line-height:1.4; text-align:left; }
    .product-name { font-weight:700; font-size:13px; text-transform:uppercase; }
    .product-note { font-style:italic; font-size:11px; }
    .c-hsn { width:70px; text-align:center; }
    .c-qty { width:90px; text-align:center; }
    .c-rate { width:56px; text-align:right; }
    .c-per { width:30px; text-align:center; }
    .c-amt { width:100px; text-align:right; }
    .tax-line-lbl { text-align:right; font-style:italic; font-weight:normal; }
    .tax-line-rate { text-align:center; }
    .tax-line-amt { text-align:right; }
    .spacer td { border-top:none !important; border-bottom:none !important; height:150px; }
    .taxsum th, .taxsum td { border:1px solid #000; padding:3px 5px; font-size:10px; }
    .taxsum td { text-align:right; }
    .taxsum td:first-child { text-align:left; }
    .taxsum th { text-align:center; font-weight:bold; }
    .sig-img { display:block; margin-left:auto; height:32px; max-width:150px; object-fit:contain; }
    .footer { text-align:center; font-size:9.5px; margin-top:6px; }
    .terms-list { font-size:9.5px; padding-left:14px; margin-top:2px; }
    .bank-lbl { display:inline-block; width:110px; font-size:10px; }
    @media print {
      .items thead { display:table-header-group; }
      .totals-block { break-inside:avoid; }
    }
  </style>
</head>
<body>
<div class="page">
  <div class="doc-title">Tax Invoice</div>
  <div class="top-strip">
    <div class="irn-block">
      <div class="row irn-row">
        <span class="lbl-inline">IRN</span>
        <span>:&nbsp;</span>
        <span class="value">{{irn}}</span>
      </div>
      {{#if ackNo}}
      <div class="row">
        <span class="lbl-inline">Ack No.</span>
        <span>:&nbsp;</span>
        <span class="value">{{ackNo}}</span>
      </div>
      {{/if}}
      {{#if ackDate}}
      <div class="row">
        <span class="lbl-inline">Ack Date</span>
        <span>:&nbsp;</span>
        <span class="value">{{ackDate}}</span>
      </div>
      {{/if}}
    </div>
    {{#if qrCodeImage}}
    <div class="einv"><div class="einv-label">e-Invoice</div><img class="qr-img" src="{{qrCodeImage}}" alt="QR Code"/></div>
    {{/if}}
  </div>

  

  <table class="inv">
    <tr>
      <td rowspan="6" style="width:48%">
        <div class="seller-hdr">
          {{#if sellerLogo}}<img class="logo-img" src="{{sellerLogo}}" alt="{{sellerCompanyName}}"/>{{/if}}
          <div class="seller-details">
            <div class="seller-name">{{sellerName}}</div>
            <div>{{sellerAddress}}</div>
            <div>GSTIN/UIN: <strong>{{sellerGSTIN}}</strong></div>
            <div>State Name : {{sellerStateName}}</div>
            {{#if sellerCIN}}<div>CIN: {{sellerCIN}}</div>{{/if}}
            <div>E-Mail : {{sellerEmail}}</div>
          </div>
        </div>
      </td>
      <td style="width:26%"><span class="lbl">Invoice No.</span><span class="bold">{{invoiceNo}}</span></td>
      <td style="width:26%"><span class="lbl">Dated</span><span class="bold">{{invoiceDate}}</span></td>
    </tr>
    <tr>
      <td><span class="lbl">Delivery Note</span>{{deliveryNote}}</td>
      <td><span class="lbl">Mode/Terms of Payment</span>{{modeOfPayment}}</td>
    </tr>
    <tr>
      <td><span class="lbl">Reference No. &amp; Date.</span>{{referenceNo}} {{#if referenceDate}}dt. {{referenceDate}}{{/if}}</td>
      <td><span class="lbl">Other References</span>{{otherReference}}</td>
    </tr>
    <tr>
      <td><span class="lbl">Buyer's Order No.</span>{{buyerOrderNo}}</td>
      <td><span class="lbl">Dated</span>{{buyerOrderDate}}</td>
    </tr>
    <tr>
      <td><span class="lbl">Dispatch Doc No.</span>{{despatchDocNo}}</td>
      <td><span class="lbl">Delivery Note Date</span>{{despatchDocDate}}</td>
    </tr>
    <tr>
      <td><span class="lbl">Dispatched through</span>{{despatchThrough}}</td>
      <td><span class="lbl">Destination</span>{{destination}}</td>
    </tr>
    <tr>
      <td rowspan="2">
        <span class="lbl">Consignee (Ship to)</span>
        <div class="bold">{{consigneeName}}</div><div>{{consigneeAddress}}</div>
        <div>GSTIN/UIN : {{consigneeGSTIN}}</div><div>PAN/IT No : {{consigneePAN}}</div>
        <div>State Name : {{consigneeStateName}} {{#if consigneeStateCode}}, Code : {{consigneeStateCode}}{{/if}}</div>
      </td>
      <td><span class="lbl">Bill of Lading/LR-RR No.</span>{{billOfLadingNo}}</td>
      <td><span class="lbl">Motor Vehicle No.</span>{{motorVehicleNo}}</td>
    </tr>
    <tr><td colspan="2"><span class="lbl">Terms of Delivery</span>{{termsOfDelivery}}</td></tr>
    <tr>
      <td>
        <span class="lbl">Buyer (Bill to)</span>
        <div class="bold">{{buyerName}}</div><div>{{buyerAddress}}</div>
        <div>GSTIN/UIN : {{buyerGSTIN}}</div><div>PAN/IT No : {{buyerPAN}}</div>
        <div>State Name : {{buyerStateName}} {{#if buyerStateCode}}, Code : {{buyerStateCode}}{{/if}}</div>
      </td>
      <td colspan="2" style="height:22px"></td>
    </tr>
    <tr>
      <td colspan="3" style="padding:0">
        <table class="items">
          <thead><tr><th class="c-sl">Sl<br>No.</th><th class="c-desc">Description of Goods</th><th class="c-hsn">HSN/SAC</th><th class="c-qty">Quantity</th><th class="c-rate">Rate</th><th class="c-per">per</th><th class="c-amt">Amount</th></tr></thead>
          <tbody>
            {{#each items}}
            <tr>
              <td class="c-sl">{{slNo}}</td>
              <td class="c-desc"><div class="product-name">{{productName}}</div>{{#each notes}}<div class="product-note">{{this}}</div>{{/each}}</td>
              <td class="c-hsn">{{hsn}}</td><td class="c-qty">{{quantity}} {{unit}}</td><td class="c-rate">{{rate}}</td><td class="c-per">{{unit}}</td><td class="c-amt">{{amount}}</td>
            </tr>
            {{/each}}
            <tr class="spacer"><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
            {{#each outputTaxLines}}
            <tr><td colspan="4" style="border-right:none"></td><td class="tax-line-lbl" style="border-left:none;border-right:none"><em>{{label}}</em></td><td class="tax-line-rate" style="border-left:none;border-right:none">{{rate}} %</td><td class="tax-line-amt" style="border-left:none">{{amount}}</td></tr>
            {{/each}}
            {{#if showRoundOff}}
            <tr><td colspan="6" style="border-right:none;text-align:right"><em>R/OFF</em></td><td style="text-align:right;border-left:none">{{roundOff}}</td></tr>
            {{/if}}
            <tr><td colspan="3" style="border-right:none"></td><td class="center bold" style="border-left:none;border-right:none">Total</td><td colspan="2" class="center bold" style="border-left:none;border-right:none">{{totalQuantity}} {{totalUnit}}</td><td style="text-align:right;border-left:none;font-weight:bold">₹ {{grandTotal}}</td></tr>
          </tbody>
        </table>
      </td>
    </tr>
    <tr><td colspan="2"><strong>Amount Chargeable (in words)</strong><br><strong>{{amountInWords}}</strong></td><td style="text-align:right;font-style:italic;font-size:10px;vertical-align:bottom">E. &amp; O.E</td></tr>
    <tr>
      <td colspan="3" style="padding:0">
        <table class="taxsum">
          <thead>
            <tr><th rowspan="2" style="text-align:left">HSN/SAC</th><th rowspan="2">Taxable<br>Value</th><th colspan="2">CGST</th><th colspan="2">SGST/UTGST</th>{{#if hasIGST}}<th colspan="2">IGST</th>{{/if}}<th rowspan="2">Total<br>Tax Amount</th></tr>
            <tr><th>Rate</th><th>Amount</th><th>Rate</th><th>Amount</th>{{#if hasIGST}}<th>Rate</th><th>Amount</th>{{/if}}</tr>
          </thead>
          <tbody>
            {{#each taxSummaryRows}}
            <tr><td>{{hsn}}</td><td>{{taxableValue}}</td><td class="center">{{cgstRate}}%</td><td>{{cgstAmount}}</td><td class="center">{{sgstRate}}%</td><td>{{sgstAmount}}</td>{{#if ../hasIGST}}<td class="center">{{igstRate}}%</td><td>{{igstAmount}}</td>{{/if}}<td>{{totalTax}}</td></tr>
            {{/each}}
            <tr><td class="bold">Total</td><td class="bold">{{taxSummaryTotal.taxableValue}}</td><td></td><td class="bold">{{taxSummaryTotal.cgstAmount}}</td><td></td><td class="bold">{{taxSummaryTotal.sgstAmount}}</td>{{#if hasIGST}}<td></td><td class="bold">{{taxSummaryTotal.igstAmount}}</td>{{/if}}<td class="bold">{{taxSummaryTotal.totalTax}}</td></tr>
          </tbody>
        </table>
      </td>
    </tr>
    <tr><td colspan="3"><strong>Tax Amount (in Words) :</strong>&nbsp;&nbsp;<strong>{{taxAmountInWords}}</strong></td></tr>
    <tr class="totals-block">
      <td colspan="2" style="font-size:9.5px;vertical-align:top">
        <strong>Declaration</strong><br>{{declaration}}<br><br>
        <strong>Company's PAN</strong> : {{companyPAN}}<br>
        <strong>Terms and Conditions</strong>
        <ol class="terms-list">{{#each termsAndConditions}}<li>{{this}}</li>{{/each}}</ol>
      </td>
      <td style="vertical-align:top;font-size:10px">
        <strong>Company's Bank Details</strong><br>
        <span class="bank-lbl">Bank Name</span>: {{bankName}}<br>
        <span class="bank-lbl">A/c No.</span>: {{bankAccountNo}}<br>
        <span class="bank-lbl">Branch &amp; IFS Code</span>: {{bankBranchIFSC}}<br>
        <div style="text-align:right;margin-top:6px">for <strong>{{sellerCompanyName}}</strong></div>
        {{#if signatureImage}}<img class="sig-img" src="{{signatureImage}}" alt="Authorised Signature"/>{{else}}<div style="height:34px"></div>{{/if}}
        <div style="text-align:right;font-size:9.5px">Authorised Signatory</div>
      </td>
    </tr>
  </table>
  <div class="footer">{{#if jurisdictionText}}<div>{{jurisdictionText}}</div>{{/if}}<div>This is a Computer Generated Invoice</div></div>
</div>
</body>
</html>
